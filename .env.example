# Copy this file to ".env" in the project root before running
# `docker compose up`, and fill in real values.

POSTGRES_DB=levtechproduction
POSTGRES_USER=levtech
POSTGRES_PASSWORD=change-this-strong-password

JWT_SECRET=change-this-to-a-long-random-string

# Port on the NAS that the app will be reachable on, e.g. http://<NAS-IP>:8080
HOST_PORT=8080
