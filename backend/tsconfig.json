{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    // "." rather than "src" so the maintenance scripts compile too and ship in
    // the image: the production stage installs with --omit=dev, so tsx is not
    // available to run them from source. Output is dist/src/** and
    // dist/scripts/** — hence `node dist/src/server.js`.
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src", "scripts"]
}
